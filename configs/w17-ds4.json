                }
              }
            },
            {
              "id": "ch5-arm",
              "type": "channel",
              "channel": {
                "label": "CH5 arm -- TRIANGLE toggles; a pad dropout disarms AND resets the toggle (reset_on_nan), so re-arming always takes a fresh deliberate press",
                "number": 5,
                "crsf_min": 172,
                "crsf_max": 1811,
                "raw_min": -32768,
                "raw_max": 32767,
                "failsafe": 172,
                "input": {
                  "id": "arm-gate",
                  "type": "and",
                  "and": {
                    "label": "toggle AND pad-alive: the liveness probe on the right goes nan when the pad dies, which makes this node nan and drives the channel to its 172 failsafe -- a naked seq would HOLD its state through a dropout",
                    "output_false": -32768,
                    "output_true": 32767,
                    "left": {
                      "id": "arm-toggle",
                      "type": "seq",
                      "seq": {
                        "label": "TRIANGLE press+release (50..1000 ms) toggles 0/32767; boots DISARMED; reset_on_nan returns it to DISARMED on any pad dropout, so an auto-reconnect can never silently re-arm",
                        "traversal_method": "clockwise",
                        "output_values": [0, 32767],
                        "activation_duration_min": 50,
                        "activation_duration_max": 1000,
                        "reset_on_nan": true,
                        "conditions": [
                          {
                            "id": "arm-btn",
                            "type": "button",
                            "button": {
                              "label": "TRIANGLE (SDL HIDAPI button 3)",
                              "number": 3,
                              "input": {
                                "id": "gp-arm",
                                "type": "gamepad",
                                "gamepad": { "id": "REPLACE-WITH-DS4-ID", "name": "DualShock 4" }
                              }
                            }
                          }
                        ]
                      }
                    },
                    "right": [
                      {
                        "id": "pad-alive",
                        "type": "linear",
                        "linear": {
                          "label": "liveness probe: constant 1 while the pad resolves, nan once it detaches",
                          "input_min": -32768,
                          "input_max": 32767,
                          "output_min": 1,
